// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SupportTicket {
  id                       String   @id @default(cuid())
  ticketNumber             String   @unique

  // Step 1: Kategorie
  category                 String   // hardware, software, network

  // Step 2: Problem Details
  problemDetail            String
  hasRestarted             Boolean

  // Step 3: Versand
  shippingOption           String   // own-packaging, avantor-box, technician, complete-swap

  // Step 4: Account & Gerätedaten
  accountNumber            String
  displayNumber            String
  street                   String   @default("")
  postalCode               String   @default("")
  city                     String   @default("")
  country                  String   @default("Deutschland")
  email                    String
  additionalDeviceAffected Boolean  @default(false)
  additionalDisplayNumbers Json     @default("[]")

  // Step 5: Kontaktdaten
  salutation               String   // herr, frau, divers
  contactPerson            String
  contactEmail             String?

  // Metadaten
  status                   String   @default("open") // open, in_progress, waiting_for_device, repair_in_progress, shipping_back, completed
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Status-Verlauf
  statusHistory            StatusHistory[]
}

model StatusHistory {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  comment    String?
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

// Anleitungen/Guides
model GuideCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  order       Int      @default(0)
  guides      Guide[]
  createdAt   DateTime @default(now())
}

model Guide {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String        // Kurzbeschreibung für Übersicht
  content     String        @db.Text // Rich-Text HTML Content
  coverImage  String?       // URL zum Titelbild
  categoryId  String
  category    GuideCategory @relation(fields: [categoryId], references: [id])
  published   Boolean       @default(false)
  publishedAt DateTime?
  chunks      GuideChunk[]  // Für Wissensdatenbank
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([published])
}

model GuideChunk {
  id         String   @id @default(cuid())
  guideId    String
  guide      Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  embedding  String   @db.Text // JSON Array der Embeddings
  chunkIndex Int
  createdAt  DateTime @default(now())

  @@index([guideId])
}

// Support Chat
model ChatSession {
  id          String        @id @default(cuid())
  visitorId   String        // Browser-ID für nicht-eingeloggte User
  visitorName String?       // Optional: Name des Besuchers
  status      String        @default("ai") // ai, team, closed
  messages    ChatMessage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([visitorId])
  @@index([status])
}

model ChatMessage {
  id             String      @id @default(cuid())
  sessionId      String
  session        ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role           String      // user, ai, team
  teamMemberName String?     // Name des Teammitglieds (nur bei role=team)
  content        String      @db.Text
  createdAt      DateTime    @default(now())

  @@index([sessionId])
}

// Wissensdatenbank
model KnowledgeDocument {
  id        String           @id @default(cuid())
  filename  String
  fileUrl   String           // Vercel Blob URL
  fileType  String           // pdf, docx, txt
  fileSize  Int
  content   String           @db.Text // Extrahierter Volltext
  chunks    KnowledgeChunk[]
  createdAt DateTime         @default(now())

  @@index([fileType])
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String            @db.Text
  embedding  String            @db.Text // JSON Array der Embeddings
  chunkIndex Int
  createdAt  DateTime          @default(now())

  @@index([documentId])
}

// System-Einstellungen
model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Support-Kategorien und Probleme (für das Support-Formular)
model SupportCategory {
  id          String           @id @default(cuid())
  key         String           @unique // z.B. "hardware", "software", "network"
  label       String // z.B. "Hardware-Probleme"
  description String
  icon        String           @default("monitor") // lucide icon name
  order       Int              @default(0)
  problems    SupportProblem[]
  createdAt   DateTime         @default(now())

  @@index([order])
}

model SupportProblem {
  id          String          @id @default(cuid())
  key         String          @unique // z.B. "led-defect"
  label       String
  description String
  categoryId  String
  category    SupportCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order       Int             @default(0)
  createdAt   DateTime        @default(now())

  @@index([categoryId])
  @@index([order])
}
